# Browser + SSR. Safe to expose because RLS is enforced in PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Required by the hit endpoint. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
HIT_HASH_SALT=replace-with-a-long-random-secret

# Public canonical URL used by metadata, canonical links, sitemap and JSON-LD.
# Set this to the final production URL (custom domain when available).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: token from Google Search Console -> URL-prefix property -> HTML tag verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=replace-with-google-verification-token
